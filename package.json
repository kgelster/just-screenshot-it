{
  "name": "just-screenshot-it",
  "version": "1.2.0",
  "type": "module",
  "description": "Chrome extension: one click captures the whole scrollable page as a single image.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=240000 tests/e2e/*.test.js",
    "package": "bash scripts/package.sh",
    "verify:package": "node scripts/verify-package.mjs",
    "store-assets": "bash scripts/store-assets.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kgelster/just-screenshot-it.git"
  }
}
