{
  "manifest_version": 3,
  "name": "Just Screenshot It",
  "version": "1.2.0",
  "description": "One click captures the whole scrollable page as a single image, named properly, saved and copied. No account, no watermark, no upload.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "offscreen",
    "storage",
    "clipboardWrite",
    "contextMenus"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Just screenshot it",
    "default_icon": {
      "16": "icons/glyph16.png",
      "32": "icons/glyph32.png",
      "48": "icons/glyph48.png",
      "128": "icons/glyph128.png"
    }
  },
  "icons": {
    "16": "icons/tile16.png",
    "32": "icons/tile32.png",
    "48": "icons/tile48.png",
    "128": "icons/tile128.png"
  },
  "options_page": "src/options.html",
  "commands": {
    "capture-full-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Capture the full page"
    }
  }
}
